{
  "schema_version": "assay_transfer_prompt_projection.v11",
  "record_contract_version": "starling_record_contract.v7",
  "source_contract_version": "source_column_contract.v1",
  "categorical_ablation_release": {
    "evaluation_measurement_kinds": ["continuous", "binary", "ordinal"],
    "ranking_families": {
      "continuous": ["continuous"],
      "categorical": ["binary", "ordinal"]
    },
    "train_components": {
      "continuous": {
        "measurement_kinds": ["continuous"],
        "max_pairs": 1250000,
        "query_degree_cap": 6,
        "retrieval_degree_cap": 6
      },
      "categorical": {
        "measurement_kinds": ["binary", "ordinal"],
        "max_pairs": 1250000,
        "query_degree_cap": 6,
        "retrieval_degree_cap": 6
      }
    },
    "variants": {
      "with_categorical": ["continuous", "categorical"]
    }
  },
  "tasks": {
    "bioavailability_ma": {
      "artifact_relpath": "outputs/chembl_tool/tasks/bioavailability_ma/evidence_library/starling_normalized_v7",
      "heldout_reservation": {
        "methodology": "scaffold",
        "included_splits": ["valid", "test"],
        "labels_relpath": "data/processed_starling/Bioavailability_Ma/scaffold/heldout_molecule_labels.jsonl"
      },
      "priority_phases": [["fg", "fh"], ["hf_bioavailability", "oral_exposure", "fa"]],
      "construction": {
        "ranking_anchor_width": 20,
        "ranking_record_degree_cap": 48,
        "source_record_sampling": {
          "oral_exposure": {"numerator": 1, "denominator": 2, "method": "stable_hash_exact"}
        },
        "ranking_anchors": {
          "continuous": {"hf_bioavailability": 40, "oral_exposure": 20, "fa": 20, "fg": 10, "fh": 20},
          "categorical": {"hf_bioavailability": 40, "oral_exposure": 20, "fa": 20, "fg": 10, "fh": 20}
        }
      },
      "sources": {
        "hf_bioavailability": {
          "template": "bioavailability_ma/hf_bioavailability.jinja",
          "both": ["smiles", "bioavailability_report_type", "comparator", "dose", "oral_exposure_mode", "qualifying_conditions", "species_or_population"],
          "retrieval_only": ["unit_text", "measurement_text", "support_text", "extra_details"],
          "constants": {"endpoint_name": "oral_bioavailability"},
          "expected_all_null_fields": ["unit_text"]
        },
        "oral_exposure": {
          "template": "bioavailability_ma/oral_exposure.jinja",
          "both": ["smiles", "endpoint_name", "statistic_type", "oral_dose", "study_context", "qualifying_conditions"],
          "retrieval_only": ["unit_text", "measurement_text", "comparator_exposure", "support_text", "extra_details"],
          "constants": {}
        },
        "fa": {
          "template": "bioavailability_ma/fa.jinja",
          "both": ["smiles", "endpoint_name", "assay_system", "condition_medium", "biological_context", "formulation_or_solid_form", "qualifying_conditions"],
          "retrieval_only": ["unit_text", "measurement_text", "support_text", "extra_details"],
          "constants": {}
        },
        "fg": {
          "template": "bioavailability_ma/fg.jinja",
          "both": ["smiles", "endpoint_name", "transporter_or_enzyme", "assay_system", "intestinal_site", "qualifying_conditions"],
          "retrieval_only": ["measurement_text", "substrate_status", "support_text", "extra_details"],
          "constants": {}
        },
        "fh": {
          "template": "bioavailability_ma/fh.jinja",
          "both": ["smiles", "endpoint_name", "assay_system", "species", "molecular_form", "enzyme_or_pathway", "qualifying_conditions"],
          "retrieval_only": ["unit_text", "measurement_text", "support_text", "extra_details"],
          "constants": {}
        }
      }
    },
